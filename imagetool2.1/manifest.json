{
  "manifest_version": 3,
  "name": "图片尺寸调整器",
  "version": "2.1",
  "description": "拖拽 / 粘贴 / 右键菜单收集图片，按预设尺寸与格式批量处理并保存到指定文件夹",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "downloads",
    "contextMenus",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "图片尺寸调整器（SAKURA）—— 点击打开侧边栏"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
